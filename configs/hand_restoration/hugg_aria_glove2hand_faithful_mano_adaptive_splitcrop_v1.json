{
  "seed": 7,
  "data": {
    "format": "hugg_aria_video",
    "manifest_summary": "data/derived/hugg_aria_diffusion/adaptive_hand_crop_v1/manifest_summary.json",
    "train_manifest": "data/derived/hugg_aria_diffusion/adaptive_hand_crop_v1/train_manifest.jsonl",
    "val_manifest": "data/derived/hugg_aria_diffusion/adaptive_hand_crop_v1/seen_eval_manifest.jsonl",
    "pinhole_root": "data/HUGG_ARIA_PINHOLE",
    "render_kind": "mano",
    "render_root": "data/HUGG_ARIA_MANO_ALIGNED",
    "render_alpha_filename": "alpha.mkv",
    "render_opacity": 1.0,
    "alpha_threshold": 0.0,
    "loss_mask_source": "mano",
    "loss_mask_root": "data/HUGG_ARIA_MANO_ALIGNED",
    "loss_mask_alpha_filename": "alpha.mkv",
    "mask_root": "outputs/sam2_hugg_aria_masks_v3_pilot",
    "output_size": 512,
    "condition_variant": "sam_mask",
    "condition_style": "glove2hand_faithful",
    "spatial_mode": "mano_adaptive_hand_crop",
    "crop_scale": 1.5,
    "adaptive_crop_policy": {
      "single_hand_scale": 1.5,
      "close_joint_scale": 1.2,
      "split_rule": "individual_1p5_square_crops_are_disjoint",
      "min_component_area": 64,
      "ring_match_distance_px": 6.0
    },
    "hand_mask_dilation_px": 3,
    "wrist_mask_enabled": true,
    "wrist_geometry_source": "mano_wrist_ring",
    "wrist_ring_root": "data/HUGG_ARIA_MANO_WRIST_RINGS",
    "wrist_length_ratio": 0.15,
    "wrist_width_scale": 1.30,
    "wrist_ring_transverse_scale": 1.30,
    "wrist_sleeve_orientation": "palm_axis",
    "wrist_sleeve_forearm_ratio": 0.60,
    "wrist_sleeve_hand_overlap_ratio": 0.25,
    "condition_fill_value": 0.0,
    "max_open_sequences": 4
  },
  "model": {
    "base_model_id": "runwayml/stable-diffusion-v1-5",
    "controlnet_model_id": null,
    "prompt": "a realistic egocentric image of a human hand",
    "negative_prompt": "deformed hand, extra fingers, blurry, cartoon",
    "conditioning_mode": "latent_mask"
  },
  "training": {
    "output_dir": "outputs/hand_restoration/hugg_aria_glove2hand_faithful_mano_adaptive_splitcrop_v1",
    "num_train_epochs": 10,
    "max_train_steps": 15380,
    "batch_size": 32,
