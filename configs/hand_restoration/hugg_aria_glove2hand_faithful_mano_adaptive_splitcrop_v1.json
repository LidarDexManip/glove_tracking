    "mixed_precision": "bf16",
    "learning_rate": 5e-6,
    "lr_scheduler": "constant_with_warmup",
    "warmup_steps": 100,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "hand_loss_weight": 10.0,
    "chunk_shuffle_frames": 150,
    "num_workers": 4,
    "shuffle": false,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "max_validation_samples": 136,
    "log_every": 10,
    "csv_log_every": 1,
    "loss_ema_decay": 0.98,
    "checkpoint_every": 1538,
    "save_full_state": true,
    "full_state_keep_last": 2,
    "validation_every": 1538,
    "validation_seed": 7,
    "use_wandb": false,
    "allow_exact_target_extension": true
  },
  "inference": {
    "steps": 20,
    "guidance_scale": 1.0,
    "controlnet_scale": 1.0
  }
}
